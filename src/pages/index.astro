  .hero__org :global(.org-node--hub .org-cap) { fill: var(--gold); font-family: var(--font-label); font-weight: 700; text-transform: uppercase; letter-spacing: .14em; font-size: 15px; fill: var(--gold); }
  .cmp-ring { fill: none; stroke: rgba(207,162,62,.32); stroke-width: 2; }
  .cmp-ring--thin { stroke: rgba(233,238,246,.12); stroke-width: 1; }
