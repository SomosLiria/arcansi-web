  .hero__index a:hover, .hero__index a:focus-visible { transform: translateY(0); background: linear-gradient(160deg, rgba(255,255,255,.95), rgba(255,255,255,.82)); color: var(--navy); }
  .hero__index a:hover svg, .hero__index a:focus-visible svg { opacity: 1; transform: translate(2px, -2px); }
