  .print__img img { width: 100%; height: 112%; object-fit: cover; display: block; filter: saturate(.9) contrast(1.03); }
  .print figcaption { font-family: var(--font-label); font-weight: 700; text-transform: uppercase; letter-spacing: .09em; font-size: .98rem; color: var(--navy); padding: .85rem .3rem .9rem; }
