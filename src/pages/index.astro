  .print--contact { margin-top: 2.75rem; }
  .print--contact .print__img img { object-position: 50% 40%; }
  @media (max-width: 900px) { .print { width: min(100%, 340px); } }

  /* ── Banda de cine ── */
  .band { position: relative; background: var(--navy-deep); overflow: hidden; isolation: isolate; }
