    position: absolute; left: 73%; top: 69%; translate: -50% 0; z-index: 1; width: max-content; justify-self: start; align-self: start; font-size: clamp(1.3rem, 1.8vw, 1.8rem); padding: .6rem 1.1rem;
    color: var(--gold); border-width: 1.5px; background: rgba(0,17,43,.5); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); mix-blend-mode: normal;
    opacity: var(--k); transform: scale(calc(1.4 - var(--k) * .4)); pointer-events: none; }
