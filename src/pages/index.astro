  .hero__route path { fill: none; stroke: var(--gold); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round;
    stroke-dasharray: var(--route-len, 2000); stroke-dashoffset: calc(var(--route-len, 2000) * (1 - clamp(0, (var(--p, 0) - .25) / .7, 1)));
