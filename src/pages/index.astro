---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
import Logo from "../components/Logo.astro";
import Diagnostico from "../components/Diagnostico.astro";
import { SITE, SITUACIONES, SERVICIOS, SERVICIOS_GRUPO, ANALISIS, CONSULTORIA, PRINCIPIOS, VALORES } from "../data/site";

const rots = [-1.6, 1.2, -0.8, 1.5, -1.2, 0.9];
---
<Base
  title="Arcansi · Consultoría para dirigentes de pymes"
  description={SITE.description}
>
  <!-- ═══ PORTADA ═══ -->
  <section class="hero field-navy" id="hero" aria-labelledby="hero-title">
    <svg class="hero__geo" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <linearGradient id="geoA" x1="1" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3D8BFF" stop-opacity="0"/><stop offset=".3" stop-color="#3D8BFF" stop-opacity=".5"/><stop offset=".5" stop-color="#3D8BFF" stop-opacity=".9"/><stop offset=".72" stop-color="#1450C8" stop-opacity=".4"/><stop offset="1" stop-color="#1450C8" stop-opacity="0"/></linearGradient>
        <linearGradient id="geoB" x1="1" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#0B3A8C" stop-opacity="0"/><stop offset=".3" stop-color="#2A6FE0" stop-opacity=".45"/><stop offset=".5" stop-color="#2A6FE0" stop-opacity=".8"/><stop offset=".72" stop-color="#0B3A8C" stop-opacity=".35"/><stop offset="1" stop-color="#0B3A8C" stop-opacity="0"/></linearGradient>
      </defs>
      <g class="geo-spin">
        <!-- Abanico de rayos desde fuera de pantalla: nunca se cruzan -->
        <line class="geo-l geo-thin " x1="1900" y1="-320" x2="701" y2="2647" stroke="url(#geoA)"/>
        <line class="geo-l geo-wide geo-d2" x1="1900" y1="-320" x2="349" y2="2479" stroke="url(#geoB)"/>
        <line class="geo-l geo-hair geo-d3" x1="1900" y1="-320" x2="-157" y2="2131" stroke="url(#geoA)"/>
        <line class="geo-l geo-thick geo-d4" x1="1900" y1="-320" x2="-363" y2="1943" stroke="url(#geoA)"/>
        <line class="geo-l geo-mid geo-d5" x1="1900" y1="-320" x2="-587" y2="1694" stroke="url(#geoB)"/>
        <line class="geo-l geo-thin " x1="1900" y1="-320" x2="-784" y2="1423" stroke="url(#geoA)"/>
        <line class="geo-l geo-wide geo-d2" x1="1900" y1="-320" x2="-1023" y2="982" stroke="url(#geoA)"/>
        <line class="geo-l geo-mid geo-d3" x1="1900" y1="-320" x2="-1218" y2="400" stroke="url(#geoB)"/>
        <line class="geo-l geo-hair geo-d4" x1="1900" y1="-320" x2="-1269" y2="125" stroke="url(#geoA)"/>
        <line class="geo-l geo-thick geo-d5" x1="1900" y1="-320" x2="-1298" y2="-208" stroke="url(#geoB)"/>
      </g>
    </svg>
    <div class="hero__spine spine" aria-hidden="true">
      <span class="spine__ring"></span>
      <span class="spine__label">Tu empresa, en orden</span>
    </div>
    <span class="rubber hero__seal" aria-hidden="true">En orden</span>
    <div class="wrap hero__inner">
      <div class="hero__copy">
      <h1 id="hero-title" class="hero__title">Ordenamos tu empresa para que no dependa todo de&nbsp;ti.</h1>
      <p class="hero__what">Consultoría para dirigentes de pymes de toda España</p>
      <p class="hero__sub">
        Hemos estado exactamente donde estás tú ahora: facturar y no ver el beneficio, un equipo que te consulta todo, desencuentros entre socios. Te acompañamos, de dirigente a dirigente, a profesionalizar tu pyme para que vuelvas a disfrutarla. Y cuando toca ejecutar, el mismo grupo lo pone en marcha.
      </p>
      <div class="hero__actions">
        <a href="/contacto/" class="stamp">
          Cuéntanos tu situación
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="#consultoria" class="hero__link">Ver en qué te ayudamos</a>
      </div>
      </div>
      <div class="hero__visual" aria-hidden="true"><svg class="hero__org" viewBox="0 0 640 560"></svg></div>
    </div>
    <nav class="hero__index" aria-label="Áreas de trabajo">
      <ul class="wrap">
        {SERVICIOS.map((s) => (
          <li><a href={`/consultoria/${s.slug}/`}>
            <span>{s.lomo}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg>
          </a></li>
        ))}
      </ul>
    </nav>
  </section>

  <!-- ═══ CONSULTORÍA ═══ -->
  <section class="section field-paper svcs" id="consultoria" aria-labelledby="serv-title">
    <div class="wrap">
      <header class="head">
        <h2 id="serv-title" class="reveal">Consultoría para quien dirige la empresa</h2>
        <p class="lede muted reveal">Trabajamos con el dueño o el equipo directivo, sobre las seis áreas que deciden si una pyme funciona sin ti. Cada empresa es diferente. No vendemos paquetes cerrados ni soluciones mágicas: trabajamos sobre lo que de verdad necesitas.</p>
      </header>
      <ul class="svcs__grid">
        {SERVICIOS.map((s) => (
          <li class="folio svcs__card reveal">
            <span class="label svcs__tab">{s.lomo}</span>
            <h3><a href={`/consultoria/${s.slug}/`}>{s.nombre}</a></h3>
            <p>{s.resumen}</p>
            <ul class="checks">
              {s.checks.map((c) => (
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"/></svg>{c}</li>
              ))}
            </ul>
            <span class="svcs__go" aria-hidden="true">Ver área <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </li>
        ))}
      </ul>
      <p class="aux reveal"><a class="label" href="/consultoria/">Ver toda la consultoría →</a></p>
    </div>
  </section>

  <!-- ═══ SITUACIONES ═══ -->
  <section class="section field-navy desk" id="situaciones" aria-labelledby="sit-title">
    <div class="wrap">
      <header class="head">
        <h2 id="sit-title" class="reveal">¿Te pasa algo de esto? Entonces es para ti.</h2>
        <p class="lede muted reveal">Son situaciones más comunes de lo que crees, y todas tienen solución.</p>
      </header>
      <ul class="desk__grid">
        {SITUACIONES.map((s, i) => (
          <li class="desk__sheet" style={`--r:${rots[i]}deg`}>
            <div class="flip">
              <div class="folio flip__face flip__front">
                <h3>{s.titulo}</h3>
                <p>{s.puntos[0]}</p>
                <button class="flip__btn" type="button" aria-expanded="false">
                  Ver cómo lo ordenamos
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12a8 8 0 0 1 14-5.3M20 4v4h-4M20 12a8 8 0 0 1-14 5.3M4 20v-4h4"/></svg>
                </button>
              </div>
              <div class="folio flip__face flip__back">
                <span class="rubber flip__stamp">Tiene solución</span>
                <p>{s.respuesta}</p>
                <a class="desk__more" href={`/situaciones/#${s.id}`}>Leer más</a>
              </div>
            </div>
          </li>
        ))}
      </ul>
      <div class="desk__close reveal">
        <p>Todos estos casos, y otros, se pueden arreglar.</p>
        <span class="rubber" data-stamp="-6">Tiene solución</span>
      </div>
    </div>
  </section>

  <Diagnostico />

  <!-- ═══ BANDA: en tu empresa, no en una presentación ═══ -->
  <section class="band" aria-label="Trabajamos en tu empresa">
    <div class="band__frame">
      <img class="band__img" src="/img/taller-panoramica.webp"
        srcset="/img/taller-panoramica-1000.webp 1000w, /img/taller-panoramica.webp 2000w" sizes="100vw"
        width="2000" height="666" loading="lazy" decoding="async"
        alt="Un consultor escucha a un responsable de taller que le explica una pieza mecanizada junto a un centro de mecanizado" />
    </div>
    <div class="band__copy wrap">
      <p class="band__quote">Trabajamos contigo en tu negocio, <span>no desde una presentación.</span></p>
      <span class="rubber band__stamp" aria-hidden="true">A pie de taller</span>
    </div>
  </section>

  <!-- ═══ METODOLOGÍA: estaciones selladas ═══ -->
  <section class="section field-paper method" id="metodologia" aria-labelledby="met-title">
    <div class="wrap">
      <header class="head">
        <h2 id="met-title" class="reveal">De la escucha a la acción</h2>
        <p class="lede muted reveal">Sin informes de cien páginas ni diagnósticos interminables. Directos al grano, paso a paso, codo a codo contigo.</p>
      </header>

      <div class="method__block">
        <div class="method__phase reveal">
          <h3>Análisis</h3>
          <p class="muted">Comprender antes de actuar.</p>
        </div>
        <ol class="method__track">
          {ANALISIS.map((e, i) => (
            <li class="station folio">
              <h4>{e.titulo}</h4>
              <p>{e.texto}</p>
              <span class="rubber rubber--ink station__stamp" data-stamp={i % 2 ? "5" : "-7"}>{e.sello}</span>
            </li>
          ))}
        </ol>
      </div>

      <div class="method__block">
        <div class="method__phase reveal">
          <h3>Consultoría</h3>
          <p class="muted">Con el diagnóstico claro, pasamos a la acción con un plan hecho a medida.</p>
        </div>
        <ol class="method__track method__track--3">
          {CONSULTORIA.map((e, i) => (
            <li class="station folio">
              <h4>{e.titulo}</h4>
              <p>{e.texto}</p>
              <span class="rubber rubber--ink station__stamp" data-stamp={i % 2 ? "6" : "-5"}>{e.sello}</span>
            </li>
          ))}
        </ol>
      </div>

      <p class="principles reveal">
        {PRINCIPIOS.map((p) => <span>{p}</span>)}
      </p>
    </div>
  </section>

  <!-- ═══ SERVICIOS DEL GRUPO ═══ -->
  <section class="section field-paper grp" id="servicios" aria-labelledby="grp-title">
    <div class="wrap">
      <header class="head">
        <h2 id="grp-title" class="reveal">Y cuando toca ejecutar, lo hacemos también</h2>
        <p class="lede muted reveal">Arcansi es hoy un grupo. Además de la consultoría, ponemos en marcha la tecnología, la imagen y la presencia que tu empresa necesita, con el mismo criterio y sin intermediarios.</p>
      </header>
      <ul class="grp__row">
        {SERVICIOS_GRUPO.map((s) => (
          <li class="reveal"><a class="grp__item" href={`/servicios/#${s.id}`}>
            <span class="label grp__tab">{s.lomo}</span>
            <span class="grp__name">{s.nombre}</span>
            <span class="grp__sum">{s.conecta}</span>
          </a></li>
        ))}
      </ul>
      <p class="aux reveal"><a class="label" href="/servicios/">Ver todos los servicios →</a></p>
    </div>
  </section>

  <!-- ═══ SOBRE ARCANSI ═══ -->
  <section class="section field-deep about" id="sobre-arcansi" aria-labelledby="about-title">
    <div class="about__mark" aria-hidden="true"><Logo tone="light" /></div>
    <div class="wrap about__grid">
      <div>
        <h2 id="about-title" class="about__title reveal">No somos teóricos de sistemas empresariales ni fans del Power&nbsp;Point.
          <em>Somos empresarios.<svg class="about__scribble" viewBox="0 0 400 24" preserveAspectRatio="none" aria-hidden="true"><path d="M3 15 C 70 6, 140 20, 210 11 S 330 6, 397 13" /></svg></em>
        </h2>
        <ul class="about__disc reveal" aria-label="Experiencia del equipo">
          <li>Ingeniería</li><li>Finanzas</li><li>Ventas y marketing</li><li>Dirección de empresas</li>
        </ul>
        <figure class="print print--about" data-r="-2" style="--r:-2deg">
          <svg class="print__clip" viewBox="0 0 24 60" aria-hidden="true"><path d="M7 14 V44 a5 5 0 0 0 10 0 V9 a8 8 0 0 0 -16 0 V46 a11 11 0 0 0 22 0 V16" fill="none" stroke="#B9C0C9" stroke-width="2.4" stroke-linecap="round"/></svg>
          <div class="print__img"><img src="/img/revisando-numeros.webp" width="900" height="900" loading="lazy" decoding="async"
            alt="Una responsable de producción y un consultor revisan juntos una hoja de márgenes, con una pieza de latón y una calculadora sobre la mesa" /></div>
          <figcaption>Números sin filtros, sobre la mesa.</figcaption>
        </figure>
      </div>
      <div class="about__body">
        <p class="reveal">Consultor y colaboradores tenemos experiencia real dirigiendo empresas. Conocemos la presión de las nóminas, lo difícil que es delegar y la sensación de que, si no estás encima de todo, las cosas no salen.</p>
        <p class="reveal">Aportamos la visión externa, fría y pragmática que el día a día no te deja ver. Somos ingenieros, sabemos de finanzas y tenemos mucha experiencia comercial. Analizamos tus números sin filtros, ordenamos tus procesos y te hablamos claro.</p>
        <div class="folio about__card reveal">
          <svg class="about__clip" viewBox="0 0 24 60" aria-hidden="true"><path d="M7 14 V44 a5 5 0 0 0 10 0 V9 a8 8 0 0 0 -16 0 V46 a11 11 0 0 0 22 0 V16" fill="none" stroke="#9AA3AE" stroke-width="2.4" stroke-linecap="round"/></svg>
          <p class="label about__cardtab">Ficha · Lo que no negociamos</p>
          <ul class="checks">
            {VALORES.map((v) => (
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"/></svg>{v}</li>
            ))}
          </ul>
        </div>
        <a href="/sobre-arcansi/" class="about__link reveal">Conoce Arcansi</a>
      </div>
    </div>
  </section>

  <!-- ═══ CONTACTO ═══ -->
  <section class="section field-paper contact" id="contacto" aria-labelledby="contact-title">
    <div class="wrap contact__grid">
      <div>
        <h2 id="contact-title" class="contact__title">¿Hablamos?</h2>
        <p class="lede">Cuéntanos tu situación sin compromiso. Si creemos que podemos ayudarte, te lo diremos. Si no, también.</p>
        <p class="contact__mail">O escríbenos a <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        <figure class="print print--contact" data-r="2" style="--r:2deg">
          <svg class="print__clip" viewBox="0 0 24 60" aria-hidden="true"><path d="M7 14 V44 a5 5 0 0 0 10 0 V9 a8 8 0 0 0 -16 0 V46 a11 11 0 0 0 22 0 V16" fill="none" stroke="#9AA3AE" stroke-width="2.4" stroke-linecap="round"/></svg>
          <div class="print__img"><img src="/img/entrega-carpeta.webp" width="900" height="900" loading="lazy" decoding="async"
            alt="Una responsable de almacén entrega una carpeta dorada a un compañero junto a un tablero de planificación" /></div>
          <figcaption>El objetivo: que tu equipo siga solo.</figcaption>
        </figure>
      </div>
      <ContactForm />
    </div>
  </section>
</Base>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches || location.search.includes("nomotion");

  // 3D de portada (carga diferida)
  const orgSvg = document.querySelector<SVGSVGElement>(".hero__org");
  const hero = document.getElementById("hero");
  if (orgSvg && hero) import("../scripts/org").then((m) => m.initOrg(orgSvg, hero, { reduce }));

  // Entrada de portada: el texto se asienta con un leve desenfoque (ya visible por defecto)
  if (!reduce) {
    gsap.from([".hero__title", ".hero__what", ".hero__sub", ".hero__actions", ".hero__index li"], {
      y: 26, filter: "blur(6px)", duration: 1.2, ease: "expo.out", stagger: 0.07, delay: 0.05, clearProps: "filter",
    });
  }

  // Banda de cine: se abre como un telón y la imagen se desplaza con profundidad
  if (!reduce) {
    const band = document.querySelector<HTMLElement>(".band");
    if (band) {
      gsap.fromTo(band, { "--clip": "18%" }, { "--clip": "0%", ease: "none",
        scrollTrigger: { trigger: band, start: "top bottom", end: "top 35%", scrub: 0.6 } });
      gsap.fromTo(band, { "--py": "-16%", "--sc": 1.08 }, { "--py": "0%", "--sc": 1, ease: "none",
        scrollTrigger: { trigger: band, start: "top bottom", end: "bottom top", scrub: 0.6 } });
      gsap.from(".band__quote", { y: 40, duration: 1.2, ease: "expo.out", scrollTrigger: { trigger: band, start: "top 65%" } });
    }
    gsap.utils.toArray<HTMLElement>(".print").forEach((el) => {
      gsap.from(el, { y: 50, duration: 1.3, ease: "expo.out", clearProps: "transform",
        scrollTrigger: { trigger: el, start: "top 88%" } });
      gsap.to(el.querySelector("img"), { yPercent: -6, ease: "none", scrollTrigger: { trigger: el, start: "top bottom", end: "bottom top", scrub: true } });
    });
  }

  // Sobre Arcansi: subrayado que se dibuja y marca de agua que gira con el scroll
  if (!reduce) {
    const path = document.querySelector<SVGPathElement>(".about__scribble path");
    if (path) {
      gsap.fromTo(path, { strokeDashoffset: 420 }, { strokeDashoffset: 0, duration: 1.1, ease: "power2.inOut",
        scrollTrigger: { trigger: ".about__title", start: "top 70%" } });
    }
    gsap.fromTo(".about__mark", { rotate: -14 }, { rotate: 10, ease: "none",
      scrollTrigger: { trigger: ".about", start: "top bottom", end: "bottom top", scrub: 1 } });
    // su aguja busca el norte por su cuenta
    const mark = document.querySelector<HTMLElement>(".about__mark");
    if (mark) {
      ScrollTrigger.create({ trigger: ".about", start: "top bottom", end: "bottom top",
        onUpdate: (st) => mark.style.setProperty("--needle", `${Math.sin(st.progress * Math.PI * 3) * 60 * (1 - st.progress)}deg`) });
    }
  }

  // Folios de situaciones: botón para darles la vuelta (táctil y teclado)
  document.querySelectorAll<HTMLButtonElement>(".flip__btn").forEach((b) => {
    b.addEventListener("click", () => {
      const li = b.closest(".desk__sheet")!;
      const on = li.classList.toggle("is-flipped");
      b.setAttribute("aria-expanded", String(on));
    });
  });

  // Tarjetas de servicio: inclinación 3D y reflejo que siguen al cursor
  if (!reduce && matchMedia("(hover: hover)").matches) {
    document.querySelectorAll<HTMLElement>(".svcs__card").forEach((card) => {
      const rx = gsap.quickTo(card, "rotationX", { duration: .6, ease: "power3.out" });
      const ry = gsap.quickTo(card, "rotationY", { duration: .6, ease: "power3.out" });
      gsap.set(card, { transformPerspective: 900 });
      card.addEventListener("pointermove", (e) => {
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
        rx((0.5 - y) * 4); ry((x - 0.5) * 5);
        card.style.setProperty("--gx", `${x * 100}%`); card.style.setProperty("--gy", `${y * 100}%`);
      });
      card.addEventListener("pointerleave", () => { rx(0); ry(0); });
    });
  }

  // Folios que caen sobre la mesa y se asientan
  if (!reduce) {
    gsap.from(".desk__sheet", {
      y: 40, duration: 1, ease: "expo.out", stagger: 0.07, clearProps: "transform",
      scrollTrigger: { trigger: ".desk__grid", start: "top 82%" },
    });
    gsap.from(".svcs__card", {
      y: 40, duration: 1, ease: "expo.out", stagger: 0.06, clearProps: "y",
      scrollTrigger: { trigger: ".svcs__grid", start: "top 85%" },
    });
  }
</script>

<style>
  .head { display: grid; gap: 1.1rem; margin-bottom: clamp(2.5rem, 5vw, 3.75rem); }
  .head h2 { font-size: var(--step-3); max-width: 20ch; }
  .field-paper .head h2 { color: var(--navy); }
  .field-navy .head h2 { color: #fff; }

  /* ── Portada ── */
  .hero { position: relative; min-height: 100svh; overflow: hidden; display: grid; grid-template-rows: 1fr auto; isolation: isolate;
    background-color: #000A1C;
    background-image:
      var(--grain),
      radial-gradient(70% 60% at 0% 0%, rgba(0,6,20,.95) 0%, transparent 70%),
      radial-gradient(60% 55% at 100% 100%, rgba(0,8,26,.9) 0%, transparent 70%),
      linear-gradient(155deg, #000A1C 0%, #00112B 30%, #001C43 55%, #03224F 70%, #000D24 100%);
    background-size: 220px, auto, auto, auto;
    background-blend-mode: soft-light, normal, normal, normal; }
  /* Capas vivas del fondo: orbes de luz que flotan + haz que barre + retícula que se desplaza */
  .hero::before, .hero::after { content: ""; position: absolute; z-index: -1; pointer-events: none; }
  .hero::before {
    inset: -25%;
    background:
      radial-gradient(22% 26% at 72% 42%, rgba(40,110,225,.45) 0%, rgba(40,110,225,.15) 40%, transparent 75%),
      radial-gradient(18% 22% at 30% 70%, rgba(20,80,190,.45) 0%, transparent 70%),
      radial-gradient(16% 20% at 55% 20%, rgba(70,140,240,.35) 0%, transparent 70%),
      radial-gradient(20% 24% at 88% 78%, rgba(8,50,140,.5) 0%, transparent 70%);
    will-change: transform, opacity;
    animation: hero-orbs 16s ease-in-out infinite alternate, hero-breathe 7s ease-in-out infinite;
  }
  .hero::after {
    inset: 0;
    background-image:
      linear-gradient(105deg, transparent 40%, rgba(120,180,255,.13) 48%, rgba(170,210,255,.07) 50%, transparent 58%),
      linear-gradient(rgba(150,190,255,.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(150,190,255,.08) 1px, transparent 1px);
    background-size: 250% 100%, 64px 64px, 64px 64px;
    background-repeat: no-repeat, repeat, repeat;
    -webkit-mask-image: radial-gradient(65% 75% at 70% 46%, #000 0%, rgba(0,0,0,.4) 55%, transparent 85%);
            mask-image: radial-gradient(65% 75% at 70% 46%, #000 0%, rgba(0,0,0,.4) 55%, transparent 85%);
    animation: hero-sweep 10s linear infinite;
  }
  @keyframes hero-orbs {
    0%   { transform: translate3d(-6%, -4%, 0) rotate(-4deg) scale(1); }
