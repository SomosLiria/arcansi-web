---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
import { SITE, SITUACIONES, SERVICIOS, COLABORADORES, ANALISIS, CONSULTORIA, PRINCIPIOS, VALORES } from "../data/site";

const rots = [-1.6, 1.2, -0.8, 1.5, -1.2, 0.9];
---
<Base
  title="Arcansi · Consultoría empresarial pragmática para pymes"
  description={SITE.description}
>
  <!-- ═══ PORTADA ═══ -->
  <section class="hero field-navy" id="hero" aria-labelledby="hero-title">
    <canvas class="hero__canvas" aria-hidden="true"></canvas>
    <div class="hero__spine spine" aria-hidden="true">
      <span class="spine__ring"></span>
      <span class="spine__label">Tu empresa, en orden</span>
    </div>
    <span class="rubber hero__seal" aria-hidden="true">En orden</span>
    <div class="wrap hero__inner">
      <h1 id="hero-title" class="hero__title">Ordenamos tu empresa para que no dependa todo de&nbsp;ti.</h1>
      <p class="hero__what">Consultoría empresarial para pymes de toda España</p>
      <p class="hero__sub">
        Hemos estado exactamente donde estás tú ahora: facturar y no ver el beneficio, un equipo que te consulta todo, desencuentros entre socios. Te ayudamos a profesionalizar tu pyme para que vuelvas a disfrutarla.
      </p>
      <div class="hero__actions">
        <a href="/contacto/" class="stamp">
          Cuéntanos tu situación
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="#servicios" class="hero__link">Ver en qué te ayudamos</a>
      </div>
    </div>
    <nav class="hero__index" aria-label="Áreas de trabajo">
      <ul class="wrap">
        {SERVICIOS.map((s) => (
          <li><a href={`/servicios/${s.slug}/`}>
            <span>{s.lomo}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg>
          </a></li>
        ))}
      </ul>
    </nav>
  </section>

  <!-- ═══ SERVICIOS ═══ -->
  <section class="section field-paper svcs" id="servicios" aria-labelledby="serv-title">
    <div class="wrap">
      <header class="head">
        <h2 id="serv-title" class="reveal">En qué podemos ayudarte</h2>
        <p class="lede muted reveal">Cada empresa es diferente. No vendemos paquetes cerrados ni soluciones mágicas: trabajamos sobre lo que de verdad necesitas.</p>
      </header>
      <ul class="svcs__grid">
        {SERVICIOS.map((s) => (
          <li class="folio svcs__card reveal">
            <span class="label svcs__tab">{s.lomo}</span>
            <h3><a href={`/servicios/${s.slug}/`}>{s.nombre}</a></h3>
            <p>{s.resumen}</p>
            <ul class="checks">
              {s.checks.map((c) => (
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"/></svg>{c}</li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
      <p class="aux reveal"><span class="label">Con colaboradores especializados:</span> {COLABORADORES.join(" · ")}</p>
    </div>
  </section>

  <!-- ═══ SITUACIONES ═══ -->
  <section class="section field-navy desk" id="situaciones" aria-labelledby="sit-title">
    <div class="wrap">
      <header class="head">
        <h2 id="sit-title" class="reveal">¿Te pasa algo de esto? Entonces es para ti.</h2>
        <p class="lede muted reveal">Son situaciones más comunes de lo que crees, y todas tienen solución.</p>
      </header>
      <ul class="desk__grid">
        {SITUACIONES.map((s, i) => (
          <li class="folio desk__sheet" style={`--r:${rots[i]}deg`}>
            <h3>{s.titulo}</h3>
            <p>{s.puntos[0]}</p>
            <a class="desk__more" href={`/situaciones/#${s.id}`}>Cómo lo ordenamos</a>
          </li>
        ))}
      </ul>
      <div class="desk__close reveal">
        <p>Todos estos casos, y otros, se pueden arreglar.</p>
        <span class="rubber" data-stamp="-6">Tiene solución</span>
      </div>
    </div>
  </section>

  <!-- ═══ METODOLOGÍA: estaciones selladas ═══ -->
  <section class="section field-paper method" id="metodologia" aria-labelledby="met-title">
    <div class="wrap">
      <header class="head">
        <h2 id="met-title" class="reveal">De la escucha a la acción</h2>
        <p class="lede muted reveal">Sin informes de cien páginas ni diagnósticos interminables. Directos al grano, paso a paso, codo a codo contigo.</p>
      </header>

      <div class="method__block">
        <div class="method__phase reveal">
          <h3>Análisis</h3>
          <p class="muted">Comprender antes de actuar.</p>
        </div>
        <ol class="method__track">
          {ANALISIS.map((e, i) => (
            <li class="station folio">
              <h4>{e.titulo}</h4>
              <p>{e.texto}</p>
              <span class="rubber station__stamp" data-stamp={i % 2 ? "5" : "-7"}>{e.sello}</span>
            </li>
          ))}
        </ol>
      </div>

      <div class="method__block">
        <div class="method__phase reveal">
          <h3>Consultoría</h3>
          <p class="muted">Con el diagnóstico claro, pasamos a la acción con un plan hecho a medida.</p>
        </div>
        <ol class="method__track method__track--3">
          {CONSULTORIA.map((e, i) => (
            <li class="station folio">
              <h4>{e.titulo}</h4>
              <p>{e.texto}</p>
              <span class="rubber station__stamp" data-stamp={i % 2 ? "6" : "-5"}>{e.sello}</span>
            </li>
          ))}
        </ol>
      </div>

      <p class="principles reveal">
        {PRINCIPIOS.map((p) => <span>{p}</span>)}
      </p>
    </div>
  </section>

  <!-- ═══ SOBRE ARCANSI ═══ -->
  <section class="section field-deep about" id="sobre-arcansi" aria-labelledby="about-title">
    <div class="wrap about__grid">
      <h2 id="about-title" class="about__title reveal">No somos teóricos de sistemas empresariales ni fans del Power&nbsp;Point. <em>Somos empresarios.</em></h2>
      <div class="about__body">
        <p class="reveal">Consultor y colaboradores tenemos experiencia real dirigiendo empresas. Conocemos la presión de las nóminas, lo difícil que es delegar y la sensación de que, si no estás encima de todo, las cosas no salen.</p>
        <p class="reveal">Aportamos la visión externa, fría y pragmática que el día a día no te deja ver. Somos ingenieros, sabemos de finanzas y tenemos mucha experiencia comercial. Analizamos tus números sin filtros, ordenamos tus procesos y te hablamos claro.</p>
        <div class="folio about__card reveal">
          <p class="label about__cardtab">Ficha · Lo que no negociamos</p>
          <ul class="checks">
            {VALORES.map((v) => (
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"/></svg>{v}</li>
            ))}
          </ul>
        </div>
        <a href="/sobre-arcansi/" class="about__link reveal">Conoce Arcansi</a>
      </div>
    </div>
  </section>

  <!-- ═══ CONTACTO ═══ -->
  <section class="section field-paper contact" id="contacto" aria-labelledby="contact-title">
    <div class="wrap contact__grid">
      <div>
        <h2 id="contact-title" class="contact__title">¿Hablamos?</h2>
        <p class="lede">Cuéntanos tu situación sin compromiso. Si creemos que podemos ayudarte, te lo diremos. Si no, también.</p>
        <p class="contact__mail">O escríbenos a <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      </div>
      <ContactForm />
    </div>
  </section>
</Base>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches || location.search.includes("nomotion");

  // 3D de portada (carga diferida)
  const canvas = document.querySelector<HTMLCanvasElement>(".hero__canvas");
  const hero = document.getElementById("hero");
  const hasGL = (() => { try { return !!document.createElement("canvas").getContext("webgl2"); } catch { return false; } })();
  if (canvas && hero && hasGL) {
    const go = () => import("../scripts/hero3d").then((m) => m.initHero(canvas, hero, { reduce }));
    "requestIdleCallback" in window ? (window as any).requestIdleCallback(go, { timeout: 900 }) : setTimeout(go, 300);
  }

  // Entrada de portada: el texto se asienta con un leve desenfoque (ya visible por defecto)
  if (!reduce) {
    gsap.from([".hero__title", ".hero__what", ".hero__sub", ".hero__actions", ".hero__index li"], {
      y: 26, filter: "blur(6px)", duration: 1.2, ease: "expo.out", stagger: 0.07, delay: 0.05, clearProps: "filter",
    });
    gsap.from(".hero__spine", { yPercent: 18, duration: 1.6, ease: "expo.out", delay: 0.15 });
  }

  // Folios que caen sobre la mesa y se asientan
  if (!reduce) {
    gsap.from(".desk__sheet", {
      y: 46, rotate: (i: number) => (i % 2 ? 6 : -6), duration: 1, ease: "expo.out", stagger: 0.07,
      scrollTrigger: { trigger: ".desk__grid", start: "top 82%" },
    });
    gsap.from(".svcs__card", {
      y: 40, duration: 1, ease: "expo.out", stagger: 0.06,
      scrollTrigger: { trigger: ".svcs__grid", start: "top 85%" },
    });
  }
</script>

<style>
  .head { display: grid; gap: 1.1rem; margin-bottom: clamp(2.5rem, 5vw, 3.75rem); }
  .head h2 { font-size: var(--step-3); max-width: 20ch; }
  .field-paper .head h2 { color: var(--navy); }
  .field-navy .head h2 { color: #fff; }

  /* ── Portada ── */
  .hero { position: relative; min-height: 100svh; overflow: hidden; display: grid; grid-template-rows: 1fr auto; isolation: isolate;
    background-image: var(--grain), radial-gradient(55% 75% at 76% 46%, #0B3170 0%, rgba(11,49,112,.35) 45%, rgba(0,28,67,0) 75%);
    background-size: 220px, auto; background-blend-mode: soft-light, normal; }
  .hero__canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; }
  .hero__inner { align-self: center; padding-block: calc(var(--tab-h) + 2.5rem) 2.5rem; }
  .hero__what { font-family: var(--font-label); font-weight: 700; text-transform: uppercase; letter-spacing: .1em; font-size: clamp(1rem, .9rem + .4vw, 1.25rem); color: var(--gold); margin-top: 1.4rem; }
  .hero__title { font-size: clamp(2.4rem, 1.4rem + 3.1vw, 4.2rem); max-width: 15ch; letter-spacing: -0.035em; color: #fff; }
  .hero__sub { margin-top: .9rem; max-width: 50ch; font-size: var(--step-1); line-height: 1.5; color: var(--on-navy); }
  .hero__actions { margin-top: 2.25rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem 2rem; }
  .hero__link { color: var(--on-navy); font-weight: 600; }
  .hero__link:hover { color: var(--gold); }
  /* Pestañas de áreas: separadores de archivador clicables */
  .hero__index { padding-bottom: 0; }
  .hero__index ul { list-style: none; margin-block: 0; padding: 0; display: flex; gap: 8px; align-items: flex-end; }
  .hero__index li { flex: 1 1 0; }
  .hero__index a { display: flex; align-items: center; justify-content: space-between; gap: .5rem;
    padding: 1rem 1.1rem .95rem; text-decoration: none; border-radius: 10px 10px 0 0;
    font-family: var(--font-label); font-weight: 700; text-transform: uppercase; letter-spacing: .09em; font-size: 1.02rem; color: var(--on-navy);
    background: rgba(255,255,255,.07); box-shadow: inset 0 1px 0 rgba(255,255,255,.16), inset 0 3px 0 rgba(207,162,62,.55);
    transform: translateY(6px); transition: transform .35s var(--ease-out), background-color .25s, color .25s; }
  .hero__index a svg { width: 1.05rem; height: 1.05rem; flex: 0 0 auto; opacity: .7; transition: transform .35s var(--ease-out), opacity .25s; }
  .hero__index a:hover, .hero__index a:focus-visible { transform: translateY(0); background: var(--paper); color: var(--navy); }
  .hero__index a:hover svg, .hero__index a:focus-visible svg { opacity: 1; transform: translate(2px, -2px); }
  /* Sello final del archivado: se estampa al terminar (--p lo fija ScrollTrigger) */
  .hero .hero__seal { --k: clamp(0, (var(--p, 0) - .86) * 8, 1);
    position: absolute; right: clamp(10rem, 19vw, 19rem); top: 58%; z-index: 1; width: max-content; justify-self: end; align-self: start; font-size: clamp(1.3rem, 1.8vw, 1.8rem); padding: .6rem 1.1rem;
    color: var(--navy-lift); border-width: 3px; background: rgba(207,162,62,.22); mix-blend-mode: multiply;
    opacity: var(--k); transform: rotate(-9deg) scale(calc(1.8 - var(--k) * .8)); pointer-events: none; }
  @media (max-width: 760px) { .hero__seal { display: none; } }
  .hero__spine { position: absolute; right: clamp(.75rem, 3vw, 3rem); bottom: 0; top: 18%; width: clamp(64px, 7vw, 104px); z-index: -1; border-radius: 6px 6px 0 0; }
  .hero__spine .spine__label { font-size: clamp(.9rem, 1.2vw, 1.15rem); padding: 1.4rem .6rem; }
  @media (max-width: 760px) {
    .hero__spine { width: 48px; top: 30%; opacity: .9; }
    .hero__spine .spine__label { display: none; }
    .hero__inner > * { max-width: calc(100% - 56px); }
    .hero::after { content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
      background: linear-gradient(to right, rgba(0,28,67,.94) 0%, rgba(0,28,67,.86) 62%, rgba(0,28,67,0) 84%); }
    .hero__index ul { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
    .hero__index a { font-size: .86rem; padding: .8rem .55rem .75rem; border-radius: 8px 8px 0 0; transform: none; }
    .hero__index a svg { width: .85rem; height: .85rem; }
  }

  /* ── Servicios ── */
  .svcs__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 3rem 1.5rem; }
  .svcs__card { padding-top: 2.25rem; box-shadow: 0 0 0 1px rgba(0,28,67,.06), 0 1px 0 #E9E9E4, 0 2px 0 #FBFBF9, 0 3px 0 #E4E4DF, 0 14px 30px -16px rgba(0,28,67,.3); }
  .svcs__tab { position: absolute; top: -1.9rem; left: 1.4rem; background: var(--navy); color: var(--gold);
    padding: .6rem .9rem .5rem; border-radius: 6px 6px 0 0; font-size: .95rem; }
  .svcs__card h3 { font-size: var(--step-1); letter-spacing: -.015em; margin-bottom: .6rem; }
  .svcs__card h3 a { color: var(--navy); text-decoration: none; }
  .svcs__card h3 a::after { content: ""; position: absolute; inset: 0; }
  .svcs__card > p { color: var(--ink-soft); font-size: .98rem; margin-bottom: 1rem; }
  .svcs__card { transition: transform .4s var(--ease-out), box-shadow .4s var(--ease-out); }
  .svcs__card:hover { transform: translateY(-6px); box-shadow: 0 2px 2px rgba(0,28,67,.06), 0 22px 40px -18px rgba(0,28,67,.4); }
  .svcs__card:focus-within { outline: 3px solid var(--gold); outline-offset: 4px; }
  .checks { list-style: none; padding: 0; margin: 0; display: grid; gap: .45rem; }
  .checks li { display: grid; grid-template-columns: 1.2rem 1fr; gap: .55rem; font-size: .93rem; font-weight: 500; }
  .checks svg { width: 1.1rem; height: 1.1rem; color: var(--gold-press); margin-top: .2rem; }
  .aux { margin-top: 3rem; color: var(--ink-soft); }
  .aux .label { color: var(--navy); font-size: 1.05rem; margin-right: .4rem; }
  @media (max-width: 980px) { .svcs__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) { .svcs__grid { grid-template-columns: 1fr; } }

  /* ── Situaciones ── */
  .desk__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .desk__sheet { transform: rotate(var(--r)); padding-block: 1.5rem; }
  .desk__sheet h3 { font-size: var(--step-1); color: var(--navy); margin-bottom: .5rem; letter-spacing: -.015em; }
  .desk__sheet p { color: var(--ink-soft); margin-bottom: .9rem; }
  .desk__more { font-weight: 600; color: var(--navy); font-size: .95rem; }
  .desk__close { margin-top: clamp(2.5rem, 5vw, 3.5rem); display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem 2rem; }
  .desk__close p { font-size: var(--step-2); font-weight: 800; color: #fff; letter-spacing: -.02em; line-height: 1.1; }
  .desk__close .rubber { font-size: 1.3rem; padding: .55rem .95rem; }
  @media (max-width: 960px) { .desk__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .desk__grid { grid-template-columns: 1fr; gap: .9rem; } }

  /* ── Metodología ── */
  .method__block { display: grid; grid-template-columns: minmax(180px, 1fr) 3.4fr; gap: clamp(1.5rem, 3vw, 3rem); margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  .method__phase h3 { font-size: var(--step-2); color: var(--navy); }
  .method__phase p { margin-top: .5rem; max-width: 24ch; }
  .method__track { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .method__track--3 { grid-template-columns: repeat(3, 1fr); }
  .station { padding-bottom: 4.5rem; }
  .station h4 { font-size: var(--step-1); color: var(--navy); margin-bottom: .6rem; }
  .station p { font-size: .98rem; color: var(--ink-soft); }
  .station__stamp { position: absolute; right: 1rem; bottom: 1.1rem; }
  .principles { display: flex; flex-wrap: wrap; gap: .5rem 0; font-family: var(--font-label); font-weight: 700; text-transform: uppercase; letter-spacing: .1em; font-size: var(--step-1); color: var(--navy); }
  .principles span:not(:last-child)::after { content: ""; display: inline-block; width: .45em; height: .45em; border-radius: 50%; background: var(--gold); margin: 0 1rem; vertical-align: .18em; }
  @media (max-width: 1080px) { .method__block { grid-template-columns: 1fr; } .method__track { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) {
    .method__track, .method__track--3 { grid-template-columns: 1fr; gap: 0; background: #FBFBF9; border-radius: 3px;
      box-shadow: 0 1px 1px rgba(0,28,67,.06), 0 10px 28px -12px rgba(0,28,67,.28); padding: .5rem 1.25rem .5rem 2.75rem; position: relative; }
    .method__track::before { content: ""; position: absolute; top: 0; bottom: 0; left: 2rem; width: 1px; background: rgba(207,162,62,.6); }
    .station.folio { background: none; box-shadow: none; border-radius: 0; padding: 1.4rem 0 3.6rem; border-bottom: 1px solid var(--paper-edge); }
    .station.folio:last-child { border-bottom: 0; }
    .station.folio::before { display: none; }
    .station__stamp { right: 0; bottom: 1.2rem; }
  }

  /* ── Sobre ── */
  .about__grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  .about__title { font-size: var(--step-3); color: #fff; }
  .about__title em { font-style: normal; color: var(--gold); display: block; margin-top: .3em; }
  .about__body { display: grid; gap: 1.5rem; color: var(--on-navy); }
  .about__link { color: var(--gold); font-weight: 700; }
  .about__card { transform: rotate(-1.2deg); margin-top: 2.25rem; }
  .about__card .checks li { font-size: 1rem; font-weight: 600; }
  .about__cardtab { position: absolute; top: -2.1rem; left: 1.5rem; background: var(--gold); color: var(--navy);
    padding: .6rem .9rem .5rem; border-radius: 6px 6px 0 0; font-size: .95rem; }
  @media (max-width: 900px) { .about__grid { grid-template-columns: 1fr; } }

  /* ── Contacto ── */
  .contact__grid { display: grid; grid-template-columns: 1fr 1.25fr; gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  .contact__title { font-size: clamp(3.2rem, 2rem + 5vw, 5.5rem); letter-spacing: -.04em; margin-bottom: 1.5rem; color: var(--navy); }
  .contact .lede { color: var(--ink); }
  .contact__mail { margin-top: 2rem; font-weight: 600; }
  .contact__mail a { color: var(--navy); }
  @media (max-width: 900px) { .contact__grid { grid-template-columns: 1fr; } }
</style>
