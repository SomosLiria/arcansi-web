  /* ── Sobre ── */
  .about__grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  .about__title { font-size: var(--step-3); color: #fff; }
  .about { overflow: hidden; }
  .about__grid { position: relative; z-index: 1; }
  .about__title { font-size: clamp(2.2rem, 1.5rem + 2.6vw, 3.7rem); }
  .about__title em { font-style: normal; color: var(--gold); display: inline-block; margin-top: .3em; position: relative; }
  .about__scribble { position: absolute; left: -2%; bottom: -.32em; width: 104%; height: .45em; overflow: visible; }
