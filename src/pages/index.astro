  /* ── Situaciones ── */
  .desk__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  /* Folio que se da la vuelta: problema delante, solución detrás */
  .desk__sheet { perspective: 1400px; transition: transform .5s var(--ease-out); }
  .desk__sheet:hover, .desk__sheet:focus-within { transform: translateY(-4px); z-index: 2; }
  .flip { display: grid; transform-style: preserve-3d; transition: transform .8s cubic-bezier(.2,.8,.2,1); height: 100%; }
  .flip__face { grid-area: 1 / 1; backface-visibility: hidden; -webkit-backface-visibility: hidden; padding-block: 1.5rem; display: flex; flex-direction: column; align-items: flex-start; }
  .flip__face { -webkit-backdrop-filter: none; backdrop-filter: none; background: linear-gradient(150deg, rgba(23,56,112,.92), rgba(9,34,78,.92)) !important; }
  .flip__back { transform: rotateY(180deg); background: linear-gradient(150deg, rgba(42,62,96,.95), rgba(14,38,80,.95)) !important; border-color: rgba(207,162,62,.45) !important; }
  @media (hover: hover) { .desk__sheet:hover .flip { transform: rotateY(180deg); } }
  .desk__sheet.is-flipped .flip { transform: rotateY(180deg); }
  .flip__face h3 { font-size: var(--step-1); color: #fff; margin-bottom: .5rem; letter-spacing: -.015em; }
  .flip__face p { color: var(--on-navy-soft); margin-bottom: 1rem; }
