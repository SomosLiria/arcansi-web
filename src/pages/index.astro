  .station:hover .station__stamp { animation: rethump .5s cubic-bezier(.6,0,.4,1); }
  @keyframes rethump { 0% { scale: 1; } 30% { scale: 1.32; opacity: .55; } 62% { scale: .93; opacity: 1; } 100% { scale: 1; } }
  @media (prefers-reduced-motion: reduce) { .station:hover .station__stamp { animation: none; } }
  .principles { display: flex; flex-wrap: wrap; gap: .5rem 0; font-family: var(--font-label); font-weight: 700; text-transform: uppercase; letter-spacing: .1em; font-size: var(--step-1); color: var(--navy); }
