    font: 600 .95rem var(--font-body); color: var(--gold); }
  .flip__btn svg { width: 1.05rem; height: 1.05rem; color: var(--gold); transition: transform .5s var(--ease-out); }
  .desk__sheet:hover .flip__btn svg { transform: rotate(180deg); }
  .flip__stamp { align-self: flex-end; margin: -.3rem -.2rem .8rem 0; font-size: .9rem; }
  .desk__more { margin-top: auto; font-weight: 600; color: var(--gold); font-size: .95rem; }
  @media (prefers-reduced-motion: reduce) { .flip { transition: none; } }
  .desk__close { margin-top: clamp(2.5rem, 5vw, 3.5rem); display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem 2rem; }
  .desk__close p { font-size: var(--step-2); font-family: var(--font-display); font-weight: 400; color: #fff; letter-spacing: -.02em; line-height: 1.1; }
  .desk__close .rubber { font-size: 1.3rem; padding: .55rem .95rem; }
  @media (max-width: 960px) { .desk__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .desk__grid { grid-template-columns: 1fr; gap: .9rem; } }

  /* ── Fotos impresas con clip ── */
  .print { position: relative; margin: 3rem 0 0; background: #FBFBF9; padding: 12px 12px 0; width: min(100%, 380px); border-radius: 16px; overflow: hidden;
    box-shadow: 0 1px 1px rgba(0,0,0,.12), 0 24px 44px -20px rgba(0,0,0,.55); transition: transform .6s var(--ease-out); }
  .print:hover { transform: translateY(-4px); }
