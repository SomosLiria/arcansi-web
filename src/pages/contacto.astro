---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
import { SITE } from "../data/site";
---
<Base
  title="Contacto: cuéntanos la situación de tu empresa"
  description="Cuéntanos sin compromiso qué pasa en tu pyme. Te responderemos personalmente por email. Consultoría empresarial para pymes de toda España."
  navTone="paper"
>
  <section class="contact field-paper">
    <div class="wrap contact__grid">
      <div>
        <h1 class="contact__title">¿Hablamos?</h1>
        <p class="lede">Cuéntanos tu situación sin compromiso. Si creemos que podemos ayudarte, te lo diremos. Si no, también.</p>
        <dl class="contact__facts">
          <div><dt class="label">Email</dt><dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
          <div><dt class="label">Ámbito</dt><dd>Pymes de toda España</dd></div>
          <div><dt class="label">Respuesta</dt><dd>Personal, por email. Sin spam ni seguimiento comercial.</dd></div>
        </dl>
      </div>
      <ContactForm />
    </div>
  </section>
</Base>

<style>
  .contact { padding-block: calc(var(--tab-h) + clamp(3rem, 8vw, 6rem)) clamp(4rem, 8vw, 7rem); min-height: 100svh; }
  .contact__grid { display: grid; grid-template-columns: 1fr 1.25fr; gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  .contact__title { font-size: clamp(3.5rem, 2rem + 6vw, 6rem); letter-spacing: -.04em; margin-bottom: 1.5rem; color: var(--navy); }
  .contact .lede { color: var(--navy); }
  .contact__facts { margin: 2.5rem 0 0; display: grid; gap: 1.25rem; }
  .contact__facts dt { font-size: 1rem; color: var(--navy); opacity: .75; }
  .contact__facts dd { margin: .2rem 0 0; font-weight: 600; }
  .contact__facts a { color: var(--navy); }
  @media (max-width: 900px) { .contact__grid { grid-template-columns: 1fr; } }
</style>
