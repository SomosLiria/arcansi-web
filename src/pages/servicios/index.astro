---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBand from "../../components/CtaBand.astro";
import { SITE, AREAS } from "../../data/site";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITE.url}/` },
      { "@type": "ListItem", position: 2, name: "Servicios", item: `${SITE.url}/servicios/` },
    ],
  },
];
---
<Base
  title="Servicios para pymes: legal, seguros, personal, ciberseguridad y digital"
  description="Pactos de socios y mediación, seguros y previsión social, externalización de personal, ciberseguridad gestionada e IA, software y web. Los servicios del grupo Arcansi para pymes."
  schema={schema}
>
  <PageHero title="Servicios del grupo Arcansi" lomo="Servicios" crumbs={[{ href: "/servicios/", label: "Servicios" }]}>
    <p>La consultoría ordena tu empresa. Alrededor de ella, el grupo resuelve lo que más preocupa a quien dirige una pyme: los socios, la protección, el equipo, la seguridad y la tecnología. Un solo interlocutor, el mismo criterio.</p>
  </PageHero>

  <section class="section field-paper">
    <div class="wrap">
      <ol class="index">
        {AREAS.map((a) => (
          <li class="index__item reveal">
            <a href={`/servicios/${a.slug}/`} class="index__link">
              <span class="index__tab label" aria-hidden="true">{a.lomo}</span>
              <span class="index__body">
                <span class="index__name">{a.nombre}</span>
                <span class="index__sum">{a.resumen}</span>
              </span>
              <svg class="index__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </li>
        ))}
      </ol>
      <div class="aux reveal">
        <h2 class="label">Primero el criterio, después la herramienta</h2>
        <p>No vendemos productos por vender. Si no tienes claro qué necesitas, empezamos por un diagnóstico de <a href="/consultoria/">consultoría</a> y te diremos con sinceridad qué merece la pena y qué no.</p>
      </div>
    </div>
  </section>
  <CtaBand title="¿Qué necesita tu empresa ahora?" text="Cuéntanos tu situación y te proponemos el servicio, o la combinación de servicios, que tiene sentido para ti." />
</Base>

<style>
  .index { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--navy); }
  .index__link { display: grid; grid-template-columns: 9rem 1fr auto; gap: 2rem; align-items: center; padding: 2rem 0; text-decoration: none; border-bottom: 1px solid var(--paper-edge);
    transition: padding .4s var(--ease-out), background-color .3s; }
  .index__tab { align-self: stretch; display: grid; place-items: center; background: var(--navy); color: var(--gold); font-size: 1.05rem; border-radius: 6px 0 0 6px; padding: .8rem; }
  .index__name { display: block; font-size: var(--step-2); font-family: var(--font-display); font-weight: 400; letter-spacing: -.025em; color: var(--navy); line-height: 1.1; }
  .index__sum { display: block; margin-top: .5rem; color: var(--ink-soft); max-width: 60ch; }
  .index__arrow { width: 2rem; height: 2rem; color: var(--navy); transition: transform .4s var(--ease-out); }
  .index__link:hover { padding-left: 1rem; background: #fff; }
  .index__link:hover .index__arrow { transform: translateX(6px); color: var(--gold-press); }
  .aux { margin-top: 4rem; max-width: 60ch; }
  .aux h2 { color: var(--navy); font-size: 1.2rem; margin-bottom: .6rem; }
  .aux a { color: var(--navy); font-weight: 700; }
  @media (max-width: 680px) { .index__link { grid-template-columns: 1fr auto; } .index__tab { grid-column: 1 / -1; justify-self: start; border-radius: 6px 6px 0 0; } }
</style>
