---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBand from "../../components/CtaBand.astro";
import { SITE, SERVICIOS_GRUPO } from "../../data/site";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITE.url}/` },
      { "@type": "ListItem", position: 2, name: "Servicios", item: `${SITE.url}/servicios/` },
    ],
  },
  ...SERVICIOS_GRUPO.map((s) => ({
    "@context": "https://schema.org",
    "@type": "Service",
    name: s.nombre,
    description: s.resumen,
    url: `${SITE.url}/servicios/#${s.id}`,
    provider: { "@id": `${SITE.url}/#arcansi` },
    areaServed: { "@type": "Country", name: "España" },
    audience: { "@type": "BusinessAudience", name: "Dirigentes de pymes" },
  })),
];
---
<Base
  title="Servicios para pymes: IA, software, web, marca y redes"
  description="Formación en IA, software a medida, web corporativa, tienda online, marca y redes sociales. Los servicios del grupo Arcansi para pymes de toda España."
  schema={schema}
>
  <PageHero title="Servicios para poner en marcha lo que decidimos" lomo="Servicios" crumbs={[{ href: "/servicios/", label: "Servicios" }]}>
    <p>La consultoría ordena tu empresa. Estos servicios ejecutan lo que hace falta después: tecnología, imagen y presencia, hechos por el mismo grupo y con el mismo criterio.</p>
  </PageHero>

  <section class="section field-paper">
    <div class="wrap">
      <ul class="grp">
        {SERVICIOS_GRUPO.map((s) => (
          <li class="folio grp__card reveal" id={s.id}>
            <span class="label grp__tab">{s.lomo}</span>
            <h2>{s.nombre}</h2>
            <p class="grp__sum">{s.resumen}</p>
            <ul class="checks">
              {s.incluye.map((c) => (
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"/></svg>{c}</li>
              ))}
            </ul>
            <p class="grp__link">{s.conecta}</p>
          </li>
        ))}
      </ul>
      <div class="aux reveal">
        <h2 class="label">Primero el criterio, después la herramienta</h2>
        <p>No vendemos tecnología por vender. Si no tienes claro qué necesitas, empezamos por un diagnóstico de <a href="/consultoria/">consultoría</a> y te diremos con sinceridad qué merece la pena y qué no.</p>
      </div>
    </div>
  </section>
  <CtaBand title="¿Qué necesita tu empresa ahora?" text="Cuéntanos tu situación y te proponemos el servicio, o la combinación de servicios, que tiene sentido para ti." />
</Base>

<style>
  .grp { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); gap: 2rem; }
  .grp__card { display: flex; flex-direction: column; gap: 1rem; scroll-margin-top: 7rem; }
  .grp__tab { align-self: flex-start; background: var(--navy); color: var(--gold); padding: .3rem .8rem; border-radius: 4px; font-size: .95rem; }
  .grp__card h2 { font-size: var(--step-2); color: var(--navy); line-height: 1.1; letter-spacing: -.02em; }
  .grp__sum { color: var(--ink-soft); }
  .checks { list-style: none; padding: 0; margin: 0; display: grid; gap: .6rem; }
  .checks li { display: grid; grid-template-columns: 1.3rem 1fr; gap: .6rem; font-weight: 500; }
  .checks svg { width: 1.2rem; height: 1.2rem; color: var(--gold-press); margin-top: .15rem; }
  .grp__link { margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--paper-edge); font-size: .95rem; color: var(--navy); font-weight: 600; }
  .aux { margin-top: 4rem; max-width: 60ch; }
  .aux h2 { color: var(--navy); font-size: 1.2rem; margin-bottom: .6rem; }
  .aux a { color: var(--navy); font-weight: 700; }
</style>
